generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Anime {
  id        Int    @id @default(autoincrement())
  nome      String
  episodios Int

  @@map("animes")
}

model Usuario {
  id    Int    @id @default(autoincrement())
  email String @unique
  senha String

  @@map("usuarios")
}
